generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  Int
  user      user     @relation(fields: [authorId], references: [id], map: "Post_authorId_fkey")

  @@index([authorId], map: "Post_authorId_fkey")
}

model profile {
  id     Int     @id @default(autoincrement())
  bio    String?
  userId Int     @unique(map: "Profile_userId_key")
  user   user    @relation(fields: [userId], references: [id], map: "Profile_userId_fkey")
}

model departments {
  id         Int       @id @default(autoincrement())
  name       String    @unique(map: "Department_name_key")
  dh_id      Int?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      user[]    @relation("DepartmentUsers")

  @@map("departments")
}

model designation {
  id         Int       @id @default(autoincrement())
  name       String    @unique(map: "Designation_title_key")
  level      Int?
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      user[]    @relation("DesignationUsers")

  @@map("designation")
}

model user {
  id            Int          @id @default(autoincrement())
  email         String       @unique(map: "User_email_key")
  name          String?
  created_at    DateTime?    @default(now()) @db.Timestamp(0)
  departmentId  Int?
  designationId Int?
  is_active     Int?         @default(1) @db.TinyInt
  password      String?
  udpated_at    DateTime?    @db.Timestamp(0)
  post          post[]
  profile       profile?
  department    departments? @relation("DepartmentUsers", fields: [departmentId], references: [id], map: "User_departmentId_fkey")
  designation   designation? @relation("DesignationUsers", fields: [designationId], references: [id], map: "User_designationId_fkey")

  @@index([departmentId], map: "User_departmentId_fkey")
  @@index([designationId], map: "User_designationId_fkey")
}
